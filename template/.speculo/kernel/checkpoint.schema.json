{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:kernel:checkpoint:v1-v2",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "change_id",
        "stage",
        "locked_decisions",
        "open_questions",
        "next_action",
        "evidence",
        "state_digest",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "change_id": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "locked_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state_digest": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "stage",
        "locked_decisions",
        "open_questions",
        "next_action",
        "evidence",
        "state_digest",
        "created_at",
        "workflow",
        "subject",
        "run_id"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "stage": {
          "type": "string"
        },
        "locked_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state_digest": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "workflow": {
          "const": "ops"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "subject": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "controller",
                "host",
                "deployment",
                "release"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
