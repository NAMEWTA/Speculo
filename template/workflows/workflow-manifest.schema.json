{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:workflow-manifest:v2",
  "title": "Current workflow discovery manifest; stages describe capabilities, not a shared runtime state machine",
  "type": "object",
  "required": ["schema_version", "id", "version", "entry", "persistent_knowledge", "works", "work_stages", "stages"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "entry": {"const": "SKILL.md"},
    "persistent_knowledge": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^<Path>\\{roots\\.state\\}/[^<>\\\\]+</Path>$"}},
    "works": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/work"}},
    "work_stages": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/work"}, "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}},
    "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "work": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-[a-z]-[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stage": {
      "type": "object", "required": ["id", "after", "inputs", "outputs", "risk", "context_budget"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "after": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "inputs": {"$ref": "#/$defs/strings"}, "outputs": {"$ref": "#/$defs/strings"},
        "risk": {"enum": ["read-only", "local-reversible", "local-destructive", "external-mutation", "production-critical"]},
        "context_budget": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
