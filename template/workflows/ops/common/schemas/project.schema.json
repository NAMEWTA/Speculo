{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:ops:project:v1",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "app",
        "shared-service"
      ]
    },
    "service_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "local",
            "git",
            "image",
            "manual"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "location",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "project_id",
    "display_name",
    "kind",
    "service_type",
    "source"
  ],
  "additionalProperties": false
}
