{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:ops:server-connection:v1",
  "type": "object",
  "properties": {
    "platform": {
      "enum": [
        "linux",
        "windows",
        "darwin"
      ]
    },
    "transport": {
      "enum": [
        "local",
        "ssh"
      ]
    },
    "connection": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "known_hosts": {
          "type": "string",
          "minLength": 1
        },
        "identity_file": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "sudo": {
          "type": "boolean"
        },
        "shell": {
          "enum": [
            "posix",
            "powershell"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "platform",
    "transport",
    "connection"
  ],
  "additionalProperties": false
}
