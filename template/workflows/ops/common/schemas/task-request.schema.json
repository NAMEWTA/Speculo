{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:ops:task-request:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "plan": {
      "type": "string",
      "minLength": 40,
      "maxLength": 32000
    },
    "valid_for_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "scope": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "server",
            "project"
          ]
        },
        "server_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "project_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "uniqueItems": true,
          "maxItems": 1
        },
        "related_project_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "uniqueItems": true
        },
        "allow_policy_changes": {
          "type": "boolean"
        },
        "allow_public_ingress": {
          "type": "boolean"
        },
        "allow_destructive": {
          "type": "boolean"
        }
      },
      "required": [
        "scope",
        "server_ids",
        "project_ids",
        "related_project_ids",
        "allow_policy_changes",
        "allow_public_ingress",
        "allow_destructive"
      ],
      "additionalProperties": false
    },
    "input_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "spec": {
            "$ref": "urn:speculo:ops:spec:v1"
          }
        },
        "required": [
          "id",
          "title",
          "spec"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "title",
    "plan",
    "valid_for_hours",
    "scope",
    "input_paths",
    "steps"
  ],
  "additionalProperties": false,
  "$comment": "Register the existing spec.schema.json $id with a standards-compliant validator. Runtime validates each frozen spec through the original spec gateway."
}
