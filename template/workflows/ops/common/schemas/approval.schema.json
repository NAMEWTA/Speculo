{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:ops:approval:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact": {
      "const": "ops-plan-approval"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "plan_digest": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "const": "approved"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "artifact",
    "run_id",
    "plan_digest",
    "approved_by",
    "approved_at",
    "decision",
    "statement"
  ],
  "additionalProperties": false
}
