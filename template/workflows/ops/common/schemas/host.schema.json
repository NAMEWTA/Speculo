{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:ops:host:v1",
  "type": "object",
  "properties": {
    "host_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "linux",
        "windows",
        "darwin"
      ]
    },
    "transport": {
      "enum": [
        "local",
        "ssh"
      ]
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "connection": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "known_hosts": {
          "type": "string",
          "minLength": 1
        },
        "identity_file": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "sudo": {
          "type": "boolean"
        },
        "shell": {
          "enum": [
            "posix",
            "powershell"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "host_services": {
      "$ref": "#/$defs/host_services"
    }
  },
  "required": [
    "host_id",
    "display_name",
    "platform",
    "transport",
    "root",
    "identity",
    "connection"
  ],
  "additionalProperties": false,
  "$defs": {
    "host_services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "wireguard",
              "nginx",
              "systemd",
              "probe",
              "other"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "listen_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "listen": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tunnel_address": {
            "type": "string",
            "minLength": 1
          },
          "config_path": {
            "type": "string",
            "minLength": 1
          },
          "public_url": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  }
}
