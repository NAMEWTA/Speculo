{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:triage-run:v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "id",
    "mode",
    "status",
    "repo",
    "change",
    "commit_sha",
    "npm_target",
    "updated_at",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact": {
      "const": "triage-run"
    },
    "id": {
      "type": "string",
      "pattern": "^TRI-[0-9]{3,}$"
    },
    "mode": {
      "enum": [
        "ci-security",
        "release-preflight",
        "release"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "blocked",
        "failed",
        "completed"
      ]
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "change": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      ]
    },
    "commit_sha": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      ]
    },
    "npm_target": {
      "enum": [
        "required",
        "not-required",
        "unknown"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "identity",
          "required",
          "version",
          "registry",
          "dist_tag",
          "observed",
          "receipt"
        ],
        "properties": {
          "kind": {
            "enum": [
              "npm",
              "github-release",
              "ci",
              "security"
            ]
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "registry": {
            "type": [
              "string",
              "null"
            ]
          },
          "dist_tag": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed": {
            "enum": [
              "pending",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "receipt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
