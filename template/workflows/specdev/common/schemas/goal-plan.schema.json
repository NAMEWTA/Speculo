{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:goal-plan:v8",
  "title": "SpecDev Goal Plan Frontmatter",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "change",
    "status",
    "modes",
    "orchestration",
    "lead",
    "integration_attempt_limit",
    "ready_for_execution",
    "ticket_execution"
  ],
  "properties": {
    "schema_version": {
      "const": 8
    },
    "artifact": {
      "const": "goal-plan"
    },
    "change": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "completed",
        "blocked"
      ]
    },
    "modes": {
      "type": "array",
      "items": {
        "enum": [
          "migration",
          "high-assurance",
          "reference-conformance",
          "release-coordination"
        ]
      },
      "uniqueItems": true
    },
    "orchestration": {
      "const": "lead-directed"
    },
    "lead": {
      "type": "string",
      "minLength": 1
    },
    "concurrent_implementation_limit": {
      "type": "integer",
      "minimum": 1
    },
    "integration_attempt_limit": {
      "type": "integer",
      "minimum": 1
    },
    "ready_for_execution": {
      "type": "boolean"
    },
    "ticket_execution": {
      "enum": [
        "auto",
        "serial",
        "parallel"
      ],
      "default": "auto"
    },
    "max_parallel_tickets": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "draft",
              "blocked",
              "completed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "ready_for_execution": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "in_progress"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "ready_for_execution": {
            "const": true
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
