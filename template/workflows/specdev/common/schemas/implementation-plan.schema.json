{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:implementation-plan:v3",
  "title": "SpecDev Parent Implementation Plan Frontmatter",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "change",
    "status",
    "source_map_revision",
    "orchestration",
    "lead",
    "integration_attempt_limit",
    "ready_for_execution",
    "ticket_execution"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "artifact": {
      "const": "implementation-plan"
    },
    "change": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "in_progress",
        "blocked",
        "completed"
      ]
    },
    "source_map_revision": {
      "type": "integer",
      "minimum": 1
    },
    "orchestration": {
      "const": "lead-directed"
    },
    "lead": {
      "type": "string",
      "minLength": 1
    },
    "concurrent_implementation_limit": {
      "type": "integer",
      "minimum": 1
    },
    "integration_attempt_limit": {
      "type": "integer",
      "minimum": 1
    },
    "ready_for_execution": {
      "type": "boolean"
    },
    "ticket_execution": {
      "enum": [
        "auto",
        "serial",
        "parallel"
      ],
      "default": "auto"
    },
    "max_parallel_tickets": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "in_progress"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "ready_for_execution": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "completed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "ready_for_execution": {
            "const": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
