{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:retro-approval:v1",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "snapshot",
    "sha256",
    "quote",
    "confirmed_at",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "quote": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
