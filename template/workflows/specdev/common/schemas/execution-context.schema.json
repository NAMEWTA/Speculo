{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:execution-context:v1",
  "title": "SpecDev change Execution Context",
  "type": "object",
  "required": [
    "schema_version",
    "change",
    "workspace_policy",
    "workspace_ref",
    "branch",
    "base_sha",
    "owner",
    "ticket_execution"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "change": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "workspace_policy": {
      "enum": [
        "current",
        "worktree"
      ]
    },
    "workspace_ref": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "ticket_execution": {
      "enum": [
        "auto",
        "serial",
        "parallel"
      ]
    },
    "max_parallel_tickets": {
      "type": "integer",
      "minimum": 1
    },
    "concurrent_implementation_limit": {
      "type": "integer",
      "minimum": 1
    },
    "integration_attempt_limit": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
