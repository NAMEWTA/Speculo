{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:retrospective:v3",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "id",
    "owner",
    "status",
    "outcome",
    "updated_at",
    "sources",
    "findings",
    "sessions"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "artifact": {
      "const": "retrospective"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "completed"
      ]
    },
    "outcome": {
      "enum": [
        "findings",
        "no-findings",
        "insufficient-evidence"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "change",
          "locator",
          "snapshot",
          "sha256",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E-[0-9]{3,}$"
          },
          "kind": {
            "enum": [
              "change",
              "project",
              "session"
            ]
          },
          "change": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "session_ref": {
            "type": "string",
            "pattern": "^S-[0-9]{3,}$"
          },
          "anchor": {
            "type": "object",
            "required": [
              "start_line",
              "end_line",
              "timestamp"
            ],
            "properties": {
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "event_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "severity",
          "evidence",
          "remediation_axis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          },
          "category": {
            "enum": [
              "navigation",
              "automated-checks",
              "coding-standards",
              "global-instructions",
              "tool-economy",
              "no-ops",
              "information-access",
              "goal-alignment",
              "decision-quality",
              "implementation",
              "verification",
              "coordination",
              "successful-practice"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3,}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "remediation_axis": {
            "enum": [
              "code-defect",
              "deterministic-check-gap",
              "context-pointer",
              "judgment-rule",
              "environment-discovery",
              "architecture-decision",
              "project-knowledge"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "host",
          "session_id",
          "locator",
          "captured_until",
          "availability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S-[0-9]{3,}$"
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "captured_until": {
            "type": "string",
            "format": "date-time"
          },
          "availability": {
            "enum": [
              "available",
              "unavailable",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
