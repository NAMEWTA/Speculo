{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:retrospective:v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "change",
    "id",
    "status",
    "outcome",
    "sources",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact": {
      "const": "retrospective"
    },
    "change": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "id": {
      "type": "string",
      "pattern": "^RETRO-[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "draft",
        "blocked",
        "completed"
      ]
    },
    "outcome": {
      "enum": [
        "findings",
        "no-findings",
        "insufficient-evidence"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
