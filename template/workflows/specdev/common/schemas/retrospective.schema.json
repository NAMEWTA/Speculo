{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:retrospective:v2",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "id",
    "owner",
    "status",
    "outcome",
    "updated_at",
    "sources",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact": {
      "const": "retrospective"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "completed"
      ]
    },
    "outcome": {
      "enum": [
        "findings",
        "no-findings",
        "insufficient-evidence"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "change",
          "locator",
          "snapshot",
          "sha256",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E-[0-9]{3,}$"
          },
          "kind": {
            "enum": [
              "change",
              "project",
              "session"
            ]
          },
          "change": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "severity",
          "evidence",
          "remediation_axis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          },
          "category": {
            "enum": [
              "navigation",
              "automated-checks",
              "coding-standards",
              "global-instructions",
              "tool-economy",
              "no-ops",
              "information-access"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3,}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "remediation_axis": {
            "enum": [
              "code-defect",
              "deterministic-check-gap",
              "context-pointer",
              "judgment-rule",
              "environment-discovery"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
