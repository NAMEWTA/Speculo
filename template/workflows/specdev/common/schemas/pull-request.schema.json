{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:pull-request:v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "change",
    "id",
    "requested",
    "status",
    "repo",
    "base_sha",
    "head_sha",
    "body_sha256",
    "verification",
    "url",
    "updated_at",
    "delivery_target"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact": {
      "const": "pull-request"
    },
    "change": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "id": {
      "type": "string",
      "pattern": "^PR-[0-9]{3,}$"
    },
    "requested": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "planned",
        "draft",
        "ready",
        "failed",
        "waived"
      ]
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verification": {
      "enum": [
        "pending",
        "passed",
        "failed",
        "unknown"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_target": {
      "enum": [
        "draft",
        "ready"
      ]
    }
  },
  "additionalProperties": false
}
