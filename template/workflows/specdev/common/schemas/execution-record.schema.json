{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:execution-record:v1",
  "title": "SpecDev execution evidence",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_context",
    "implementation_owners",
    "status",
    "checkpoint",
    "verification",
    "attempts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ticket_id": {
      "type": "string",
      "pattern": "^T-\\d{2,}$"
    },
    "purpose": {
      "const": "direct-spec"
    },
    "change": {
      "type": "string",
      "minLength": 1
    },
    "workspace_context": {
      "const": "README.md#execution-context"
    },
    "implementation_owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "active",
        "review",
        "verified",
        "blocked",
        "cancelled"
      ]
    },
    "checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "evidence",
        "e2e"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "e2e": {
          "type": "object",
          "required": [
            "required",
            "status",
            "reason",
            "evidence"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed",
                "not-required"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "required": [
        "ticket_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "purpose"
            ]
          },
          {
            "required": [
              "change"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "purpose",
        "change"
      ],
      "not": {
        "required": [
          "ticket_id"
        ]
      }
    }
  ]
}
