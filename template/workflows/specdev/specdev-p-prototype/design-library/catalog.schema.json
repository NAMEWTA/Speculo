{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speculo:specdev:design-library-catalog:v1",
  "title": "Speculo design library catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "templates", "references"],
  "properties": {
    "schema_version": { "const": 1 },
    "templates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/template" } },
    "references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "localPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]+:)[^?#]+$" },
    "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "template": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "tasks", "platforms", "density", "preview", "reference_ids", "avoid", "guide"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 },
        "tasks": { "$ref": "#/$defs/strings" },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["desktop", "web", "mobile"] } },
        "density": { "enum": ["compact", "default", "comfortable", "touch"] },
        "preview": { "$ref": "#/$defs/localPath" }, "guide": { "$ref": "#/$defs/localPath" },
        "reference_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "avoid": { "$ref": "#/$defs/strings" }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "source", "revision", "license", "document", "guide"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri", "pattern": "^https://" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "license": { "type": "string", "minLength": 1 },
        "document": { "$ref": "#/$defs/localPath" }, "guide": { "$ref": "#/$defs/localPath" }
      }
    }
  }
}
