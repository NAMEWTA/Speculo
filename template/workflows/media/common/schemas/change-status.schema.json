{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change",
    "status",
    "current_work",
    "works_run",
    "revision",
    "blockers",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "change": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "active",
        "blocked",
        "completed",
        "cancelled"
      ]
    },
    "current_work": {
      "enum": [
        null,
        "media/init-setup",
        "media/brief",
        "media/deconstruct",
        "media/video",
        "media/hand-drawn",
        "media/publish-draft",
        "media/retro"
      ]
    },
    "works_run": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "media/init-setup",
          "media/brief",
          "media/deconstruct",
          "media/video",
          "media/hand-drawn",
          "media/publish-draft",
          "media/retro"
        ]
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
