{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "change": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "artifacts": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "owner", "kind", "root", "path", "version", "sha256", "evidence_kind", "depends_on"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "owner": {"enum": ["media/init-setup", "media/brief", "media/deconstruct", "media/video", "media/hand-drawn", "media/publish-draft", "media/retro"]},
          "kind": {"enum": ["document", "data", "report", "prompt", "image-request", "image", "video-project", "video-preview", "video-final", "local-draft"]},
          "root": {"enum": ["change", "media"]},
          "path": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "evidence_kind": {"enum": ["executed", "simulated", "unverified"]},
          "depends_on": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "version", "sha256"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                "version": {"type": "integer", "minimum": 1},
                "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
